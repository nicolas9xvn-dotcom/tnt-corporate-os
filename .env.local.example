# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API key, free tier (aistudio.google.com/apikey -> Create API key).
# Server-only — no NEXT_PUBLIC_ prefix, so it's never sent to the browser.
# Required for "Giao việc" (task assignment) on the CEO Command Center to work.
GEMINI_API_KEY=

# Optional text fallback providers — only used when Gemini's free quota runs
# out AND the agent has no direct reports (delegating agents stay
# Gemini-only, see agent-runner.ts). Tried in this order: DeepSeek, Grok,
# OpenAI. Leave any of these blank to skip that provider entirely — nothing
# breaks, Gemini-only behavior is unchanged. Get keys from
# platform.deepseek.com, console.x.ai, and platform.openai.com respectively
# (each is a separate paid account, not the same as GEMINI_API_KEY).
DEEPSEEK_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=

# Optional: override the model used for each fallback provider, in case the
# defaults in text-fallback.ts (unverified — this project can't reach these
# APIs to test live) get rejected as "model not found".
# DEEPSEEK_MODEL=deepseek-chat
# GROK_MODEL=grok-4
# OPENAI_MODEL=gpt-4o-mini

# Optional: override the Gemini model used for real image generation (only
# agents flagged agents.image_generation = true use this — see migration
# 0013 and agent-runner.ts). Uses the SAME GEMINI_API_KEY above — free tier,
# no extra account. Unverified model name — override here if it 404s.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: read-only bridge into AME29 Nail's SEPARATE Firebase app
# (ame29-nail.netlify.app — real bookings + revenue, not part of this
# project). Only used by agents flagged can_read_schedule/can_read_revenue
# (see migration 0014). Value is the ENTIRE content of the Firebase service
# account JSON file (Firebase Console -> Project settings -> Service
# accounts -> Generate new private key), pasted as one value — paste it
# directly into Vercel's Environment Variables, never into chat or a
# committed file. This key can read AND write everything in that Firebase
# project (Firestore Rules don't apply to it) — src/lib/firebase-admin.ts
# only ever calls .get(), never .set()/.update()/.delete()/.add(), but that
# discipline lives in this project's code, not in the key's own permissions.
# If you want Google to enforce read-only at the key level too, create a
# separate service account with only the "Cloud Datastore Viewer" IAM role
# instead of the default one.
FIREBASE_SERVICE_ACCOUNT_KEY=
