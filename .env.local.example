# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key (console.anthropic.com -> API Keys). Server-only — no
# NEXT_PUBLIC_ prefix, so it's never sent to the browser. Required for
# "Giao việc" (task assignment) on the CEO Command Center to work.
ANTHROPIC_API_KEY=
